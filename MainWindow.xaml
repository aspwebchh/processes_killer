<Window x:Class="ProcessesKiller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="进程结束工具"
        Height="660"
        MinHeight="460"
        Width="1200"
        MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="TrimmedCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Content="刷新"
                            Click="RefreshButton_Click" />
                    <Button x:Name="KillSelectedButton"
                            Style="{StaticResource DangerButtonStyle}"
                            MinWidth="112"
                            Margin="0,0,8,0"
                            Content="结束选中"
                            Click="KillSelectedButton_Click" />
                    <Button Style="{StaticResource BaseButtonStyle}"
                            MinWidth="140"
                            Margin="0,0,8,0"
                            Content="结束当前列表进程"
                            Click="KillAllButton_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource FilterLabelStyle}"
                               Margin="0,0,10,0"
                               Text="筛选" />
                    <ComboBox x:Name="ProcessFilterComboBox"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Height="34"
                              MinWidth="180"
                              DisplayMemberPath="DisplayName"
                              HorizontalContentAlignment="Left"
                              IsTextSearchEnabled="True"
                              ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"
                              ItemsSource="{Binding ProcessFilterOptions}"
                              SelectedValuePath="NormalizedName"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              SelectionChanged="ProcessFilterComboBox_SelectionChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 进程列表 -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <DataGrid x:Name="ProcessGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      IsReadOnly="True"
                      ItemsSource="{Binding Processes}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      PreviewMouseRightButtonDown="ProcessGrid_PreviewMouseRightButtonDown"
                      Sorting="ProcessGrid_Sorting"
                      SelectionChanged="ProcessGrid_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu Background="White"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="4">
                        <MenuItem Header="结束该进程"
                                  Click="KillSingleMenuItem_Click"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Padding="14,8" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="进程名" Binding="{Binding Name}" Width="130" />
                    <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80" />
                    <DataGridTextColumn Header="会话" Binding="{Binding SessionId}" Width="70" />
                    <DataGridTextColumn Header="内存" Binding="{Binding MemoryDisplay}" SortMemberPath="MemoryBytes" Width="100" />
                    <DataGridTextColumn Header="线程" Binding="{Binding ThreadCount}" SortMemberPath="ThreadCountValue" Width="70" />
                    <DataGridTextColumn Header="启动时间" Binding="{Binding StartTimeDisplay}" Width="160" />
                    <DataGridTextColumn Header="窗口标题"
                                        Binding="{Binding MainWindowTitle}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Width="190" />
                    <DataGridTextColumn Header="可执行路径"
                                        Binding="{Binding ProcessPath}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Width="260" />
                    <DataGridTemplateColumn Header="命令行" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CommandLine}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowDuration="60000">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="760"
                                                 Placement="Mouse"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <TextBlock MaxWidth="740"
                                                       Text="{Binding CommandLine}"
                                                       TextWrapping="Wrap" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock x:Name="ProcessCountTextBlock"
                               FontFamily="Segoe UI, Microsoft YaHei UI"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock FontFamily="Segoe UI, Microsoft YaHei UI"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Text="最近结果：" />
                    <TextBlock x:Name="LastResultTextBlock"
                               FontFamily="Segoe UI, Microsoft YaHei UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Text="就绪" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
